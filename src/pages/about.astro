<style>
  /* About — elevated into the shared design language (scoped to this page) */
  .about-kicker {
    font-family: var(--body); font-style: italic; font-weight: 400;
    font-size: 0.96rem; color: var(--ember-ink);
    display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.9rem;
  }
  .about-tick { width: 1.7rem; height: 1px; background: var(--ember-ink); display: inline-block; flex-shrink: 0; opacity: 0.75; }
  .about-header h1 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3rem); line-height: 1.05; letter-spacing: -0.01em;
  }
  .about-header .page-subtitle {
    font-family: var(--body); font-style: italic; font-weight: 300;
    font-size: clamp(1.05rem, 1.9vw, 1.25rem); color: var(--text-dim); line-height: 1.5;
    max-width: 48ch;
  }
  /* Lead paragraph */
  .prose > p:first-of-type {
    font-size: clamp(1.12rem, 1.8vw, 1.3rem); line-height: 1.6; color: var(--text);
  }
  .prose > p:first-of-type strong { font-weight: 500; }
  /* Section headings in the display face */
  .prose h2 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 1.75rem); letter-spacing: -0.005em;
  }
  /* Section headings sit in the same display face as the prose h2s above them,
     so the page reads as one hierarchy rather than two competing label styles. */
  .about-h2 {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(1.4rem, 2.6vw, 1.75rem); letter-spacing: -0.005em;
    line-height: 1.2; color: var(--text); margin: 0 0 1.1rem;
  }
  .affiliation-org a {
    color: var(--text-dim); text-decoration: underline; text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--ember-ink) 35%, transparent);
  }
  .affiliation-org a:hover { color: var(--text); text-decoration-color: var(--ember-ink); }
  .profile-links {
    font-family: var(--heading); font-size: 0.95rem; color: var(--text-faint);
    display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center;
  }
  .profile-links a {
    color: var(--ember-ink); text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--ember-ink) 35%, transparent);
  }
  .profile-links a:hover { text-decoration-color: var(--ember-ink); }
  .profile-links .sep { color: var(--text-faint); }
  .pub-title a {
    color: var(--text); text-decoration: underline; text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, var(--ember-ink) 38%, transparent);
    transition: text-decoration-color 0.2s ease;
  }
  .pub-title a:hover { text-decoration-color: var(--ember-ink); }
  /* Works still awaiting a URL — render as plain text, not a dead link */
  .pub-title a[data-needs-url] { color: inherit; text-decoration: none; pointer-events: none; }
  .practice > p { margin-bottom: 1rem; }
  .practice-lead {
    font-size: clamp(1.08rem, 1.9vw, 1.24rem); line-height: 1.56;
    color: var(--text); max-width: 60ch; margin-bottom: 1.4rem;
  }
  .practice-intent {
    font-family: var(--display); font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.4; color: var(--text); max-width: 44ch; margin-top: 1.4rem;
  }
  .longer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .longer-head { margin-bottom: 1.4rem; }
  .prev-roles {
    font-size: 1rem; line-height: 1.62; color: var(--text-dim);
    max-width: 66ch; margin: 0 0 1rem;
  }
  .honour {
    display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.4rem 1rem;
    padding: 0.7rem 0; border-bottom: 1px solid var(--border);
  }
  .honour-year {
    font-family: var(--heading); font-size: 0.8rem; font-weight: 300;
    color: var(--text-faint); font-variant-numeric: tabular-nums;
  }
  .honour-body { display: flex; flex-direction: column; gap: 0.12rem; }
  .honour-name { font-size: 1rem; color: var(--text); line-height: 1.35; }
  .honour-detail { font-family: var(--heading); font-size: 0.8rem; font-weight: 300; color: var(--text-dim); }
  @media (max-width: 520px) { .honour { grid-template-columns: 1fr; } }

</style>
