---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('work'))
  .filter(p => !p.data.draft && p.data.domain === 'Strategy & Delivery')
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
---

<Base title="Strategy & Program Delivery — Sarah Barns">
  <div class="page-header">
    <p class="page-kicker"><span class="ktick"></span><em>practice &amp; advisory</em></p>
    <h1>Strategy &amp; Program Delivery</h1>
    <p class="page-intro">
      My strategic advisory and delivery work supports organisations to lead future-focused digital
      transformation programs that cultivate shared value. Clients and partners span public and
      private sector organisations in cultural heritage, media, design and urban governance.
    </p>
  </div>

  <div class="publications">
    {items.map(r => (
      <div class="pub-item">
        <div class="pub-title">
          {r.data.href ? <a href={r.data.href} rel="noopener">{r.data.title}</a> : r.data.title}
        </div>
        <div class="pub-details">
          {r.data.authors && <span>{r.data.authors}, </span>}
          {r.data.venue}, {r.data.yearLabel ?? r.data.year}
        </div>
        {r.data.note && <p class="strategy-description">{r.data.note}</p>}
        {r.data.openAccess && (
          <a class="pub-oa" href={r.data.openAccess} rel="noopener">
            <span class="pub-oa-dot" aria-hidden="true"></span>Free to read
          </a>
        )}
      </div>
    ))}
  </div>

  <section class="strategy-cta">
    <p>Enquiries about strategy, advisory or research partnerships:
      <a href="mailto:sarah@studioesem.com">sarah@studioesem.com</a></p>
  </section>
</Base>

<style>
  .strategy-description { font-size: 0.95rem; color: var(--text-dim); line-height: 1.6; margin: 0.4rem 0 0; max-width: 68ch; }
  .pub-oa {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--heading); font-size: 0.66rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.09em;
    color: var(--oa-ink); text-decoration: none;
    background: var(--oa-bg); border: 1px solid var(--oa-line);
    border-radius: 2px; padding: 0.16rem 0.45rem; margin-top: 0.5rem;
  }
  .pub-oa:hover { border-color: var(--oa-ink); background: var(--oa-bg-hover); }
  .pub-oa-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .strategy-cta {
    margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--border);
    font-family: var(--heading); font-size: 0.9rem; color: var(--text-dim);
  }
</style>
