---
// Filterable list of work entries, shared by the domain pages.
import type { CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'work'>[];
  typeOrder?: string[];
  groups?: { title: string; types: string[] }[];
}
const { items, typeOrder, groups } = Astro.props;

// Creative and strategy entries carry their destination in a `links` array
// rather than `href`, which is the publisher field. Without this fallback
// their titles render as dead text and the link data is never used.
const titleHref = (pub: CollectionEntry<'work'>) =>
  pub.data.href ?? pub.data.links?.[0]?.href ?? null;

// Pills follow the same sequence as the sections below them.
const TYPE_ORDER = typeOrder ?? [
  'Monograph', 'Book', 'Journal Papers', 'Book Chapters',
  'Commissioned Research Contracts', 'Working Paper', 'Fellowships',
  'Keynotes & Invited Talks', 'Conferences',
  'Research Project', 'PhD thesis', 'Voices', 'Dataset',
  'Essay', 'Interviews',
  'Commissioned Strategy & Advisory', 'Strategy Project',
  'Exhibitions', 'Creative Project', 'Creative Research',
];
const pubs = items;
const types = TYPE_ORDER.filter(t => pubs.some(p => p.data.type === t));

// When groups are given the list is sectioned rather than a single date-sorted run.
const sections = (groups ?? [])
  .map(g => ({ ...g, items: pubs.filter(p => g.types.includes(p.data.type)) }))
  .filter(g => g.items.length > 0);
const grouped = sections.length > 0;


function typeClass(t: string) {
  return 'type-' + t.toLowerCase().replace(/\s+/g, '-');
}
---

  <div class="pub-filters">
    <button class="pub-filter is-active" data-filter="all">All <span class="pub-count">{pubs.length}</span></button>
    {types.map(t => (
      <button class="pub-filter" data-filter={t}>
        {t}<span class="pub-count">{pubs.filter(p => p.data.type === t).length}</span>
      </button>
    ))}
  </div>

  {grouped ? sections.map(section => (
    <section class="pub-section" data-section={section.title}>
      <h2 class="pub-section-head">{section.title}<span class="pub-section-n">{section.items.length}</span></h2>
      <ol class="pub-list">
        {section.items.map(pub => (
      <li
        class={`pub-row ${typeClass(pub.data.type)}`}
        data-type={pub.data.type}
        data-areas={(pub.data.areas ?? []).join('|')}
      >
        <div class="pub-year">{pub.data.yearLabel ?? pub.data.year}</div>
        <div class="pub-body">
          <h2 class="pub-row-title">
            {titleHref(pub)
              ? <a href={titleHref(pub)} rel="noopener">{pub.data.title}</a>
              : pub.data.title}
          </h2>
          <div class="pub-row-details">
            {pub.data.authors && <span>{pub.data.authors}</span>}
            {pub.data.authors && <span class="pub-sep">·</span>}
            <span>{pub.data.venue}</span>
            {pub.data.citations && <span class="pub-sep">·</span>}
            {pub.data.citations && <span>{pub.data.citations}+ citations</span>}
          </div>
          {pub.data.note && <p class="pub-note">{pub.data.note}</p>}
          <div class="pub-row-foot">
            <span class="pub-tag">{pub.data.type}</span>
            {pub.data.doi && (
              <a class="pub-doi" href={`https://doi.org/${pub.data.doi}`} rel="noopener">doi:{pub.data.doi}</a>
            )}
            {pub.data.isbn && <span class="pub-isbn">isbn:{pub.data.isbn}</span>}
            {pub.data.ntro && <span class="pub-ntro">NTRO</span>}
            {pub.data.licence && <span class="pub-licence">{pub.data.licence}</span>}
            {pub.data.openAccess && (
              <a class="pub-oa" href={pub.data.openAccess} rel="noopener">
                <span class="pub-oa-dot" aria-hidden="true"></span>
                {/youtube\.com|youtu\.be|vimeo/.test(pub.data.openAccess)
                  ? 'Watch'
                  : pub.data.audio || pub.data.openAccess.includes('soundcloud.com')
                    ? 'Listen'
                    : 'Free to read'}
              </a>
            )}
          </div>
        </div>
      </li>
        ))}
      </ol>
    </section>
  )) : (
    <ol class="pub-list">
      {pubs.map(pub => (
      <li
        class={`pub-row ${typeClass(pub.data.type)}`}
        data-type={pub.data.type}
        data-areas={(pub.data.areas ?? []).join('|')}
      >
        <div class="pub-year">{pub.data.yearLabel ?? pub.data.year}</div>
        <div class="pub-body">
          <h2 class="pub-row-title">
            {titleHref(pub)
              ? <a href={titleHref(pub)} rel="noopener">{pub.data.title}</a>
              : pub.data.title}
          </h2>
          <div class="pub-row-details">
            {pub.data.authors && <span>{pub.data.authors}</span>}
            {pub.data.authors && <span class="pub-sep">·</span>}
            <span>{pub.data.venue}</span>
            {pub.data.citations && <span class="pub-sep">·</span>}
            {pub.data.citations && <span>{pub.data.citations}+ citations</span>}
          </div>
          {pub.data.note && <p class="pub-note">{pub.data.note}</p>}
          <div class="pub-row-foot">
            <span class="pub-tag">{pub.data.type}</span>
            {pub.data.doi && (
              <a class="pub-doi" href={`https://doi.org/${pub.data.doi}`} rel="noopener">doi:{pub.data.doi}</a>
            )}
            {pub.data.isbn && <span class="pub-isbn">isbn:{pub.data.isbn}</span>}
            {pub.data.ntro && <span class="pub-ntro">NTRO</span>}
            {pub.data.licence && <span class="pub-licence">{pub.data.licence}</span>}
            {pub.data.openAccess && (
              <a class="pub-oa" href={pub.data.openAccess} rel="noopener">
                <span class="pub-oa-dot" aria-hidden="true"></span>
                {/youtube\.com|youtu\.be|vimeo/.test(pub.data.openAccess)
                  ? 'Watch'
                  : pub.data.audio || pub.data.openAccess.includes('soundcloud.com')
                    ? 'Listen'
                    : 'Free to read'}
              </a>
            )}
          </div>
        </div>
      </li>
      ))}
    </ol>
  )}

  <p class="pub-empty" hidden>
    Nothing of that kind here yet. <button type="button" class="pub-clear-inline">Clear filters</button>
  </p>

<style>
  .page-intro-lead {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(1.15rem, 2.1vw, 1.4rem); line-height: 1.35;
    color: var(--text); letter-spacing: -0.005em; max-width: 34ch;
  }
  .page-intro-lead + .page-intro { margin-top: 0.7rem; }

  /* Canonical links: squared, ember-tinted, outbound. Deliberately not the
     rounded outline of the filters — these leave the site, they don't filter it. */
  .pub-canon {
    display: flex; flex-wrap: wrap; gap: 0.45rem;
    margin-top: 1.8rem;
  }
  .canon {
    display: inline-flex; align-items: baseline; gap: 0.5rem;
    font-family: var(--heading); font-size: 0.78rem; font-weight: 400;
    letter-spacing: 0.01em; color: var(--ember-ink); text-decoration: none;
    background: var(--ember-bg);
    border: 1px solid color-mix(in srgb, var(--ember-ink) 22%, transparent);
    border-radius: 3px; padding: 0.42rem 0.7rem;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .canon:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--ember-ink) 55%, transparent);
    background: color-mix(in srgb, var(--ember-ink) 8%, transparent);
  }
  .canon:focus-visible { outline: 2px solid var(--ember-ink); outline-offset: 2px; }
  .canon-id {
    font-size: 0.68rem; color: var(--text-faint);
    font-variant-numeric: tabular-nums; letter-spacing: 0.02em;
  }
  .canon-out { font-size: 0.72rem; opacity: 0.6; }
  @media (max-width: 480px) { .canon-id { display: none; } }

  .pub-filters {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;
    margin: 1.6rem 0 0.5rem; padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
  }
  .pub-filter {
    font-family: var(--heading); font-size: 0.75rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--text-dim); background: none;
    border: 1px solid var(--border); border-radius: 100px;
    padding: 0.3rem 0.7rem; cursor: pointer;
    display: inline-flex; align-items: center; gap: 0.4rem;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .pub-filter:hover { color: var(--text); border-color: var(--border-hover); }
  .pub-filter.is-active {
    color: var(--accent); border-color: var(--accent);
    background: var(--accent-bg); font-weight: 500;
  }
  .pub-count { font-size: 0.68rem; opacity: 0.72; font-variant-numeric: tabular-nums; }
  /* Sits in the filter row but navigates away, so it carries the ember tint
     of the canonical links rather than the neutral outline of a filter. */
  .pub-filter-out {
    text-decoration: none; color: var(--ember-ink);
    border-color: color-mix(in srgb, var(--ember-ink) 30%, transparent);
    background: var(--ember-bg); cursor: pointer;
  }
  .pub-filter-out:hover { color: var(--text); border-color: var(--ember-ink); }

  .pub-list { list-style: none; padding: 0; margin: 0; }
  .pub-section[hidden] { display: none; }
  .pub-section-head {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem); line-height: 1.2;
    color: var(--text); margin: 2.6rem 0 0.2rem;
    display: flex; align-items: baseline; gap: 0.6rem;
  }
  .pub-section:first-of-type .pub-section-head { margin-top: 1.4rem; }
  .pub-section-n {
    font-family: var(--heading); font-size: 0.72rem; font-weight: 500;
    color: var(--text-faint); font-variant-numeric: tabular-nums;
  }
  .pub-row {
    display: grid; grid-template-columns: 5.5rem 1fr; gap: 1.2rem;
    padding: 1.6rem 0; border-bottom: 1px solid var(--border);
  }
  .pub-row[hidden] { display: none; }
  .pub-year {
    font-family: var(--heading); font-size: 0.86rem; font-weight: 500;
    color: var(--text-dim); font-variant-numeric: tabular-nums;
    padding-top: 0.28rem; line-height: 1.4;
  }
  .pub-row-title {
    font-family: var(--display); font-size: 1.22rem; font-weight: 400;
    line-height: 1.28; letter-spacing: -0.005em; color: var(--text);
    margin: 0 0 0.35rem;
  }
  .pub-row-title a {
    color: inherit; text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--ember-ink) 32%, transparent);
    transition: text-decoration-color 0.2s ease;
  }
  .pub-row-title a:hover { text-decoration-color: var(--ember-ink); }
  .pub-row-details {
    font-family: var(--heading); font-size: 0.85rem; font-weight: 400;
    color: var(--text-dim); display: flex; flex-wrap: wrap; gap: 0.4rem;
  }
  .pub-sep { color: var(--text-faint); }
  .pub-note {
    font-size: 0.94rem; line-height: 1.55; color: var(--text-dim);
    margin: 0.6rem 0 0; max-width: 62ch;
  }
  .pub-row-foot {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; margin-top: 0.55rem;
  }
  .pub-row-foot .pub-tag { margin-top: 0; }
  .pub-doi {
    font-family: var(--heading); font-size: 0.72rem; font-weight: 400;
    color: var(--text-dim); text-decoration: underline; text-underline-offset: 2px;
    text-decoration-color: transparent; transition: all 0.2s ease;
  }
  .pub-doi:hover { color: var(--ember-ink); text-decoration-color: var(--ember-ink); }

  .pub-ntro {
    font-family: var(--heading); font-size: 0.62rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.09em; color: #6E56A8;
    border: 1px solid color-mix(in srgb, #6E56A8 30%, transparent);
    background: color-mix(in srgb, #6E56A8 8%, transparent);
    border-radius: 2px; padding: 0.14rem 0.42rem;
  }
  .pub-licence {
    font-family: var(--heading); font-size: 0.62rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-faint);
    border: 1px solid var(--border); border-radius: 2px; padding: 0.14rem 0.42rem;
  }
  .pub-isbn {
    font-family: var(--heading); font-size: 0.72rem; font-weight: 400;
    color: var(--text-dim); font-variant-numeric: tabular-nums;
  }

  /* Green-OA marker: a copy exists somewhere free, wherever it is deposited. */
  .pub-oa {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--heading); font-size: 0.66rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.09em;
    color: var(--oa-ink); text-decoration: none;
    background: var(--oa-bg); border: 1px solid var(--oa-line);
    border-radius: 2px; padding: 0.16rem 0.45rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .pub-oa:hover { border-color: var(--oa-ink); background: var(--oa-bg-hover); }
  .pub-oa:focus-visible { outline: 2px solid var(--oa-ink); outline-offset: 2px; }
  .pub-oa-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

  .pub-filter.is-empty { opacity: 0.32; }
  .pub-filter.is-empty:not(.is-active) { pointer-events: none; }
  .pub-clear-inline {
    font-family: var(--heading); font-size: 0.8rem; color: var(--ember-ink);
    background: none; border: none; border-bottom: 1px solid var(--ember-ink);
    padding: 0; cursor: pointer;
  }
  .pub-empty {
    font-family: var(--heading); font-size: 0.85rem; font-weight: 300;
    color: var(--text-faint); padding: 2rem 0;
  }
  .pub-more { margin-top: 1.2rem; }
  .pub-more a { font-family: var(--heading); font-size: 0.85rem; color: var(--text-dim); }

  @media (max-width: 600px) {
    .pub-row { grid-template-columns: 1fr; gap: 0.3rem; }
    .pub-year { padding-top: 0; }
  }
</style>

<script>
  const typeBtns = document.querySelectorAll<HTMLButtonElement>('.pub-filter[data-filter]');
  const rows = document.querySelectorAll<HTMLLIElement>('.pub-row');
  const empty = document.querySelector<HTMLParagraphElement>('.pub-empty');
  const clearBtn = document.querySelector<HTMLButtonElement>('.pub-clear-inline');

  let wantType = 'all';

  function apply() {
    let shown = 0;
    rows.forEach(row => {
      const match = wantType === 'all' || row.dataset.type === wantType;
      row.hidden = !match;
      if (match) shown++;
    });
    document.querySelectorAll<HTMLElement>('.pub-section').forEach(sec => {
      const any = Array.from(sec.querySelectorAll<HTMLLIElement>('.pub-row')).some(r => !r.hidden);
      sec.hidden = !any;
    });
    if (empty) empty.hidden = shown > 0;
  }

  // /research?type=... lands pre-filtered
  const wanted = new URLSearchParams(location.search).get('type');
  if (wanted) {
    const match = Array.from(typeBtns).find(b => b.dataset.filter === wanted);
    if (match) {
      wantType = wanted;
      typeBtns.forEach(b => b.classList.toggle('is-active', b === match));
    }
  }
  apply();

  typeBtns.forEach(btn => btn.addEventListener('click', () => {
    wantType = btn.dataset.filter ?? 'all';
    typeBtns.forEach(b => b.classList.toggle('is-active', b === btn));
    apply();
  }));

  clearBtn?.addEventListener('click', () => {
    wantType = 'all';
    typeBtns.forEach(b => b.classList.toggle('is-active', b.dataset.filter === 'all'));
    apply();
  });
</script>
