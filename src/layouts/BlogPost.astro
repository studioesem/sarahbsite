---
import Base from './Base.astro';

interface Resource {
  label: string;
  href: string;
  type?: string;
}

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: string;
    updatedDate?: string;
    category?: string;
    topic?: string;
    resources?: Resource[];
  };
}

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.pubDate);
const formattedDate = date.toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });

const categoryClass = frontmatter.category
  ? 'cat-' + frontmatter.category.toLowerCase().replace(/\s+/g, '-')
  : '';

const resources = frontmatter.resources ?? [];
const isExternal = (href: string) => /^https?:\/\//.test(href);

// Per-post Article schema. The author points at the same @id used by the Person
// graph in Base.astro, so each piece is attached to Sarah's identity rather than
// floating free. datePublished/dateModified are what search engines and crawlers
// read as freshness; without them a post is just undated text.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://sarahbarns.com').href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': canonical + '#article',
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: new Date(frontmatter.pubDate).toISOString(),
  dateModified: new Date(frontmatter.updatedDate ?? frontmatter.pubDate).toISOString(),
  mainEntityOfPage: canonical,
  url: canonical,
  inLanguage: 'en-AU',
  ...(frontmatter.topic ? { about: frontmatter.topic } : {}),
  ...(frontmatter.category ? { genre: frontmatter.category } : {}),
  author: { '@id': 'https://civicinterplay.io/#sarahbarns' },
  publisher: { '@id': 'https://civicinterplay.io/#sarahbarns' },
};
---

<Base title={`${frontmatter.title} — Sarah Barns`} description={frontmatter.description} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
  <article>
    <div class="post-page-header">
      {frontmatter.category && <span class={`post-category ${categoryClass}`}>{frontmatter.category}</span>}
      <h1>{frontmatter.title}</h1>
      <div class="post-page-meta">
        <span>{formattedDate}</span>
        {frontmatter.topic && <span class="dot"></span>}
        {frontmatter.topic && <span class="meta-topic">{frontmatter.topic}</span>}
      </div>
      {frontmatter.description && <p class="post-description">{frontmatter.description}</p>}
    </div>
    <div class="prose">
      <slot />
    </div>

    {resources.length > 0 && (
      <aside class="post-resources">
        <p class="section-label">In this post</p>
        <ul class="resource-list">
          {resources.map(r => (
            <li class="resource-item">
              <a
                class="resource-link"
                href={r.href}
                {...(isExternal(r.href) ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span class="resource-type">{r.type ?? (isExternal(r.href) ? 'LINK' : 'FILE')}</span>
                <span class="resource-label">{r.label}</span>
                <span class="resource-arrow" aria-hidden="true">{isExternal(r.href) ? '↗' : '↓'}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div class="post-footer">
      <a href="/">All writing</a>
    </div>
  </article>
</Base>
