          Email
        </a>
      </div>
    </div>
  </div>

  <hr class="divider" />

  <div class="posts-header">Recent Writing</div>
  <ul class="post-list">
    {posts.map(post => (
      <li class="post-item">
        <a href={`/writing/${post.id.replace(/\.md$/, '')}`} class="post-link">
          <div class="post-meta">
            <span class="post-date">{formatDate(post.data.pubDate)}</span>
            <span class="post-dot"></span>
            <span class="post-read-time">{estimateReadTime(post.body ?? '')} min read</span>
            {post.data.category && <span class={`post-category ${categoryClass(post.data.category)}`}>{post.data.category}</span>}
          </div>
          <div class="post-title">{post.data.title}</div>
          <p class="post-excerpt">{post.data.description}</p>
        </a>
      </li>
    ))}
  </ul>

  <div class="all-posts">
    <a href="/writing">All Writing</a>
  </div>
</Base>
