---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Industry-facing outputs from the publications collection — reports, working
// papers and white papers belong with the advisory work, not the scholarly record.
const STRATEGY_TYPES = ['Report', 'Working Paper', 'White Paper'];
const reports = (await getCollection('publications'))
  .filter(p => !p.data.draft && STRATEGY_TYPES.includes(p.data.type))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
---

<Base title="Strategy — Sarah Barns">
  <div class="page-header">
    <p class="page-kicker"><span class="ktick"></span><em>practice &amp; advisory</em></p>
    <h1>Strategy</h1>
    <p class="page-intro">Civic AI governance, participatory design, and place-based strategy work delivered through Studio ESEM — for cultural institutions, councils, and communities.</p>
  </div>

  <ul class="strategy-list">
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2025–ongoing</span>
          <span class="post-dot"></span>
          <span class="post-category cat-civic-ai">Civic AI</span>
        </div>
        <div class="strategy-title">Civic AI Diagnostic Toolkit</div>
        <p class="strategy-description">A standalone consulting offering for local governments and institutions assessing their readiness for AI adoption — starting with place, participation, and governance rather than procurement and technology.</p>
        <p class="strategy-partner">Studio ESEM</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2026</span>
          <span class="post-dot"></span>
          <span class="post-category cat-placemaking">Placemaking</span>
        </div>
        <div class="strategy-title">Safer Cities: Her Way 2 — Her Place</div>
        <p class="strategy-description">A STORYBOX-based program for the NSW Safer Cities grant, using plinths, totems, NCounter sensors, MoodRing surveys, and walkshop methodology to gather and amplify women's and gender diverse people's experiences of safety in public space.</p>
        <p class="strategy-partner">NSW Government &middot; Studio ESEM</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2025–2026</span>
          <span class="post-dot"></span>
          <span class="post-category cat-storybox">Storytelling</span>
        </div>
        <div class="strategy-title">STORYBOX Community Storytelling System</div>
        <p class="strategy-description">Full-stack deployment of STORYBOX for the Inner West Museum of Rugby League — from QR-code submission forms through Cloudflare Workers and Webflow CMS to outdoor CUBE displays and community walls.</p>
        <p class="strategy-partner">Inner West Council &middot; Museum of Rugby League</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2025–2026</span>
          <span class="post-dot"></span>
          <span class="post-category cat-civic-ai">Civic AI</span>
        </div>
        <div class="strategy-title">Gathering Intelligences Workshop Program</div>
        <p class="strategy-description">A six-movement half-day workshop exploring human, ecological, and multi-species intelligences — grounded in Indigenous data sovereignty and Country-centred methods. Includes a custom pre-workshop AI agent and React/Next.js interface.</p>
        <p class="strategy-partner">Co-designed with Irina Panovich &middot; aiio studio</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2025</span>
          <span class="post-dot"></span>
          <span class="post-category cat-evaluation">Evaluation</span>
        </div>
        <div class="strategy-title">Seeing the Whole Picture</div>
        <p class="strategy-description">A concept for AI-assisted evaluation methodology to track cross-agency investment in remote Indigenous communities in the Kimberley region. First Nations-led partnership structure using composite investment pictures and CARE Principles.</p>
        <p class="strategy-partner">Liyan Foundation</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2025</span>
          <span class="post-dot"></span>
          <span class="post-category cat-environment">Circular Economy</span>
        </div>
        <div class="strategy-title">The Long Goodbye Studio</div>
        <p class="strategy-description">Workshop concept exploring AI's material footprint through circular economy storytelling — energy, water, e-waste. Includes a digital footprint calculator deployed on Civic Interplay.</p>
        <p class="strategy-partner">Studio ESEM</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2024–2025</span>
          <span class="post-dot"></span>
          <span class="post-category cat-governance">Governance</span>
        </div>
        <div class="strategy-title">Future Now: A Pattern Language for Climate Resilience</div>
        <p class="strategy-description">A project for the Australian Museum's Bicentennial Commission — Flourish network visualisations and community changemaker interviews mapping patterns of climate resilience across Australian communities.</p>
        <p class="strategy-partner">Australian Museum</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2024</span>
          <span class="post-dot"></span>
          <span class="post-category cat-storybox">Storytelling</span>
        </div>
        <div class="strategy-title">Brisbane 2032 Olympics EOI</div>
        <p class="strategy-description">Expression of interest materials for Studio ESEM/STORYBOX participation in Brisbane 2032 cultural programming — positioning civic digital storytelling infrastructure as Olympic cultural legacy.</p>
        <p class="strategy-partner">Studio ESEM &middot; STORYBOX</p>
      </div>
    </li>
    <li class="strategy-item">
      <div class="strategy-inner">
        <div class="strategy-meta">
          <span class="strategy-year">2013–ongoing</span>
          <span class="post-dot"></span>
          <span class="post-category cat-placemaking">Placemaking</span>
        </div>
        <div class="strategy-title">40+ Placemaking Programs</div>
        <p class="strategy-description">Over a decade of participatory placemaking programs delivered for cultural institutions, councils, and communities — forming the foundation of the STORYBOX platform and Studio ESEM's practice-led methodology.</p>
        <p class="strategy-partner">ABC &middot; Australian Museum &middot; NGA &middot; UNSW &middot; Canterbury Bankstown Council &middot; and others</p>
      </div>
    </li>
  </ul>

  <div class="cta">
    <p>Interested in working together? I take on a small number of strategy and advisory engagements each year.</p>
    <a href="mailto:sarah@studioesem.com">Get in touch</a>
  </div>

  {reports.length > 0 && (
    <div class="publications" id="reports">
      <h2 class="strategy-h2">Strategy Reports</h2>
      <p class="strategy-lede">
        Reports, working papers and white papers written for institutions and government —
        the industry-facing half of the record. Peer-reviewed work sits on <a href="/research">Research</a>.
      </p>
      {reports.map(r => (
        <div class="pub-item">
          <div class="pub-title">
            {r.data.href ? <a href={r.data.href} rel="noopener">{r.data.title}</a> : r.data.title}
          </div>
          <div class="pub-details">{r.data.venue}, {r.data.yearLabel ?? r.data.year}</div>
          {r.data.note && <p class="strategy-description">{r.data.note}</p>}
          <span class="pub-tag">{r.data.type}</span>
        </div>
      ))}
    </div>
  )}
</Base>

<script>
  // Scroll-driven node highlight — same mechanism as the writing list & manifesto thread
  const items = document.querySelectorAll('.strategy-item');
  if (items.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-active', e.isIntersecting)),
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    items.forEach((el) => obs.observe(el));
  }
</script>
