---
// Scratch page — not linked from anywhere, not meant to ship.
// Four candidate display faces set against real site copy so the choice
// can be made on Sarah's own words rather than a specimen sheet.
import Base from '../layouts/Base.astro';

const FACES = [
  {
    id: 'young',
    name: 'Young Serif',
    status: 'current',
    stack: "'Young Serif', Georgia, serif",
    note: 'What the site uses now. Slab-ish, sturdy, even colour. Reads institutional — solid but not especially directional.',
  },
  {
    id: 'fraunces',
    name: 'Fraunces',
    status: 'soft / wonky',
    stack: "'Fraunces', Georgia, serif",
    note: 'Old-style with deliberate wobble in the curves and soft wedge serifs. Warm and hand-made. Least corporate of the four.',
  },
  {
    id: 'instrument',
    name: 'Instrument Serif',
    status: 'sharp / editorial',
    stack: "'Instrument Serif', Georgia, serif",
    note: 'High contrast, narrow set, hairline thins. Literary-journal masthead energy. Most elegant, least warm.',
  },
  {
    id: 'bricolage',
    name: 'Bricolage Grotesque',
    status: 'contemporary sans',
    stack: "'Bricolage Grotesque', system-ui, sans-serif",
    note: 'Not a serif at all. Grotesque skeleton with odd details and mixed widths. Biggest departure — changes the voice, not just the dress.',
  },
];

const BODIES = [
  {
    name: 'Inter',
    status: 'current',
    stack: "'Inter', system-ui, sans-serif",
    note: 'What the site uses now. Engineered for screens, very even, very common — the default sans of the last five years. Legible, but it carries no point of view.',
  },
  {
    name: 'Newsreader',
    status: 'screen-first serif',
    stack: "'Newsreader', Georgia, serif",
    note: 'Drawn specifically for reading on screen. Open, slightly informal, warm. This is what the site was originally designed with, per the README — worth seeing again.',
  },
  {
    name: 'Spectral',
    status: 'serif, more colour',
    stack: "'Spectral', Georgia, serif",
    note: 'Narrower and darker on the page than Newsreader, with more contrast. Holds long paragraphs well and gives the text a denser, more literary texture.',
  },
  {
    name: 'Literata',
    status: 'sturdy reading serif',
    stack: "'Literata', Georgia, serif",
    note: 'Generous x-height, sturdy serifs, built for long-form reading. The most comfortable at length; slightly less distinctive than Spectral.',
  },
  {
    name: 'Instrument Sans',
    status: 'sans, with character',
    stack: "'Instrument Sans', system-ui, sans-serif",
    note: 'If you want to stay with a sans but leave Inter behind. Slightly condensed, a little more idiosyncratic, still completely neutral at small sizes.',
  },
];

// Newsreader is the chosen body face — these are the display faces that could sit over it.
const NEWSREADER = "'Newsreader', Georgia, serif";
const PAIRS = [
  {
    name: 'Instrument Serif',
    with: 'Newsreader',
    status: 'editorial',
    display: "'Instrument Serif', Georgia, serif",
    note: 'The classic move: a high-contrast display serif over an open, low-contrast reading serif. They are clearly related but never compete, because the contrast does the separating. Most likely to still look right in three years.',
  },
  {
    name: 'Fraunces',
    with: 'Newsreader',
    status: 'warm / crafted',
    display: "'Fraunces', Georgia, serif",
    note: 'Both are old-style, so this is a close harmony rather than a contrast — Fraunces carries all the character and Newsreader stays quiet underneath. Risk is muddiness at small display sizes; check the "Selected writing" heading.',
  },
  {
    name: 'Bricolage Grotesque',
    with: 'Newsreader',
    status: 'most contrast',
    display: "'Bricolage Grotesque', system-ui, sans-serif",
    note: 'Sans display over serif body. The sharpest separation of the five and the most contemporary. Makes the site read as a design practice more than a scholarly one — which may or may not be what you want.',
  },
  {
    name: 'Young Serif',
    with: 'Newsreader',
    status: 'smallest change',
    display: "'Young Serif', Georgia, serif",
    note: 'Keeps your current display face and only swaps the body. Young Serif is chunky where Newsreader is open, so they do separate — but this is the least directional option, which is what you were reacting against.',
  },
  {
    name: 'Newsreader',
    with: 'Newsreader',
    status: 'one family',
    display: "'Newsreader', Georgia, serif",
    note: 'One family throughout, separated by size and weight alone. The quietest, most self-assured option — and the hardest to get wrong. Worth seeing before you rule it out.',
  },
];

const SAMPLE = `For over twenty years, my work has been guided by a single question: who gets to decide what value technological systems create? I came to this question through sound. My PhD examined real-time city technologies reimagined as connection points to the "real times of space" — using ambient sound archives to create mobile listening experiences that reveal contested spatial histories.`;
---

<Base title="Font lab — Sarah Barns">
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Instrument+Serif:ital@0;1&family=Bricolage+Grotesque:opsz,wght@12..96,300..700&family=Newsreader:opsz,wght@6..72,300..600&family=Spectral:wght@300;400;600&family=Literata:opsz,wght@7..72,300..600&family=Instrument+Sans:wght@400..700&display=swap"
  />

  <div class="page-header">
    <p class="page-kicker"><span class="ktick"></span><em>scratch page — not linked, not shipped</em></p>
    <h1>Font lab</h1>
    <p class="page-intro">
      Five pairings, each showing headings and body copy together on real copy from your site —
      Newsreader as the reading face throughout, with a different display face over it. The two
      reference sections further down show each face on its own.
    </p>
  </div>

  <div class="fl-divider fl-divider-first">
    <span class="fl-divider-label">Pairings — Newsreader body</span>
  </div>

  {PAIRS.map(pair => (
    <section class="fl-panel fl-pair">
      <div class="fl-head">
        <span class="fl-name">{pair.name} <span class="fl-over">over</span> {pair.with}</span>
        <span class="fl-status">{pair.status}</span>
      </div>

      <div class="fl-specimen fl-page" style={`--face: ${pair.display}; --text-face: ${NEWSREADER}`}>
        <h2 class="fl-h1">Research</h2>
        <p class="fl-lead">Cultivating and creating public histories and strategies for digital urbanism.</p>
        <p class="fl-para">
          Two decades of scholarship on how digital systems reshape place, citizenship and collective
          governance — from archival listening and urban sound, through platform urbanism, to civic AI.
        </p>

        <div class="fl-rule"></div>

        <h3 class="fl-h2">Selected writing &amp; publications</h3>
        <p class="fl-item">Platform Urbanism: Negotiating Platform Ecosystems in Connected Cities</p>
        <p class="fl-small">Palgrave Macmillan, 2019 &middot; 548+ citations</p>
        <p class="fl-item">The death and life of the real-time city: Re-imagining the city of digital urbanism</p>
        <p class="fl-small">Doctoral thesis, public history — awarded April 2011</p>

        <div class="fl-rule"></div>

        <p class="fl-para fl-para-lead">
          For over twenty years, my work has been guided by a single question: who gets to decide what
          value technological systems create?
        </p>
        <p class="fl-para">
          I came to this question through sound. My PhD examined real-time city technologies reimagined
          as connection points to the “real times of space” — using ambient sound archives to create
          mobile listening experiences that reveal contested spatial histories.
        </p>
      </div>

      <p class="fl-note">{pair.note}</p>
    </section>
  ))}

  <div class="fl-divider">
    <span class="fl-divider-label">Reference — display faces alone</span>
  </div>

  {FACES.map(face => (
    <section class="fl-panel">
      <div class="fl-head">
        <span class="fl-name">{face.name}</span>
        <span class="fl-status">{face.status}</span>
      </div>

      <div class="fl-specimen" style={`--face: ${face.stack}`}>
        <h2 class="fl-h1">Research</h2>
        <p class="fl-lead">Cultivating and creating public histories and strategies for digital urbanism.</p>
        <p class="fl-body">
          Two decades of scholarship on how digital systems reshape place, citizenship and collective
          governance — from archival listening and urban sound, through platform urbanism, to civic AI.
        </p>

        <div class="fl-rule"></div>

        <h3 class="fl-h2">Selected writing &amp; publications</h3>
        <p class="fl-item">Platform Urbanism: Negotiating Platform Ecosystems in Connected Cities</p>
        <p class="fl-meta">Palgrave Macmillan, 2019 · 548+ citations</p>
        <p class="fl-item">The death and life of the real-time city: Re-imagining the city of digital urbanism</p>
        <p class="fl-meta">Doctoral thesis, public history — awarded April 2011</p>

        <div class="fl-rule"></div>

        <p class="fl-name-test">Sarah Barns</p>
        <p class="fl-quote">“Golden threads structuring space through time.”</p>
      </div>

      <p class="fl-note">{face.note}</p>
    </section>
  ))}

  <div class="fl-divider">
    <span class="fl-divider-label">Part two — body copy</span>
  </div>

  <p class="page-intro fl-intro-two">
    The face that actually does the reading. Same paragraph from your About page each time, set at the
    site's real body size, with the small meta text underneath — that pairing is where a body face
    either holds together or doesn't.
  </p>

  {BODIES.map(body => (
    <section class="fl-panel">
      <div class="fl-head">
        <span class="fl-name">{body.name}</span>
        <span class="fl-status">{body.status}</span>
      </div>

      <div class="fl-specimen" style={`--face: ${body.stack}`}>
        <p class="fl-para fl-para-lead">{SAMPLE}</p>
        <p class="fl-para">
          Through Studio ESEM, founded 2011, I work with cultural institutions, councils, and communities
          to build participatory digital infrastructure. The studio sits at the intersection of research,
          strategy, and making — every project is both a practical intervention and a research contribution.
        </p>
        <p class="fl-small">
          Urban Studies, 2021 &middot; Palgrave Macmillan, 2019 &middot; 548+ citations &middot; doi:10.1177/00420980211014026
        </p>
      </div>

      <p class="fl-note">{body.note}</p>
    </section>
  ))}
</Base>

<style>
  .fl-panel {
    margin-top: 3rem; padding-top: 1.6rem;
    border-top: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 1.1rem;
  }
  .fl-head { display: flex; align-items: baseline; gap: 0.8rem; flex-wrap: wrap; }
  .fl-name {
    font-family: var(--heading); font-size: 0.78rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--text);
  }
  .fl-status {
    font-family: var(--heading); font-size: 0.68rem; font-weight: 300;
    letter-spacing: 0.08em; color: var(--text-faint);
    border: 1px solid var(--border); border-radius: 100px; padding: 0.12rem 0.5rem;
  }

  .fl-specimen { display: flex; flex-direction: column; gap: 0.5rem; }
  .fl-h1 {
    font-family: var(--face); font-weight: 400; margin: 0;
    font-size: clamp(2.4rem, 6vw, 3.6rem); line-height: 1.02;
    letter-spacing: -0.015em; color: var(--text);
  }
  .fl-lead {
    font-family: var(--face); font-weight: 400; margin: 0.3rem 0 0;
    font-size: clamp(1.2rem, 2.3vw, 1.5rem); line-height: 1.3;
    letter-spacing: -0.005em; color: var(--text); max-width: 34ch;
  }
  .fl-body {
    font-family: var(--body); font-size: 1rem; line-height: 1.6;
    color: var(--text-dim); max-width: 60ch; margin: 0.5rem 0 0;
  }
  .fl-rule { height: 1px; background: var(--border); margin: 1.2rem 0 0.6rem; }
  .fl-h2 {
    font-family: var(--face); font-weight: 400; margin: 0 0 0.5rem;
    font-size: clamp(1.4rem, 2.7vw, 1.8rem); line-height: 1.18;
    letter-spacing: -0.008em; color: var(--text);
  }
  .fl-item {
    font-family: var(--face); font-weight: 400; margin: 0.7rem 0 0;
    font-size: 1.12rem; line-height: 1.32; color: var(--text); max-width: 52ch;
  }
  .fl-meta {
    font-family: var(--heading); font-size: 0.8rem; font-weight: 300;
    color: var(--text-faint); margin: 0.15rem 0 0;
  }
  .fl-name-test {
    font-family: var(--face); font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    margin: 1.1rem 0 0; letter-spacing: -0.01em; color: var(--text);
  }
  .fl-quote {
    font-family: var(--face); font-size: clamp(1.1rem, 2.1vw, 1.35rem);
    line-height: 1.4; color: var(--text-dim); margin: 0.4rem 0 0; max-width: 40ch;
  }

  /* Pairing specimens: display face on headings, --text-face on running text,
     boxed so each pairing reads as one page rather than a run of samples. */
  .fl-page {
    background: var(--ember-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: clamp(1.3rem, 3.5vw, 2.2rem);
  }
  .fl-page .fl-para,
  .fl-page .fl-small { font-family: var(--text-face); }
  .fl-over {
    font-family: var(--body); font-style: italic; font-weight: 400;
    text-transform: none; letter-spacing: 0; color: var(--text-faint);
  }
  .fl-divider-first { margin-top: 2.6rem; padding-top: 1.6rem; }

  /* Body-copy specimens: real reading size, real measure. */
  .fl-para {
    font-family: var(--face); font-weight: 400;
    font-size: 1.05rem; line-height: 1.68; color: var(--text-dim);
    max-width: 65ch; margin: 0 0 1rem;
  }
  .fl-para-lead {
    font-size: clamp(1.12rem, 1.8vw, 1.3rem); line-height: 1.6; color: var(--text);
  }
  .fl-small {
    font-family: var(--face); font-weight: 400;
    font-size: 0.85rem; line-height: 1.5; color: var(--text-faint); margin: 0;
  }

  .fl-divider {
    margin-top: 5rem; padding-top: 2.4rem;
    border-top: 2px solid var(--ember-ink);
    display: flex; align-items: center;
  }
  .fl-divider-label {
    font-family: var(--heading); font-size: 0.72rem; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.16em; color: var(--ember-ink);
  }
  .fl-intro-two { margin-top: 0.9rem; }

  .fl-note {
    font-family: var(--body); font-size: 0.92rem; font-style: italic;
    line-height: 1.55; color: var(--text-dim); max-width: 62ch;
    margin: 0.4rem 0 0; padding-left: 0.9rem;
    border-left: 2px solid var(--ember-ink);
  }
</style>
