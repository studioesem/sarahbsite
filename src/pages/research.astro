---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('work'))
  .filter(p => !p.data.draft && p.data.domain === 'Research')
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
---

<Base title="Research — Sarah Barns">
  <div class="page-header">
    <p class="page-kicker"><span class="ktick"></span><em>the published record</em></p>
    <h1>Research</h1>
    <p class="page-intro page-intro-lead">
      Cultivating and creating public histories and strategies for digital urbanism.
    </p>
    <p class="page-intro">
      Two decades of scholarship on how digital systems reshape place, citizenship and collective
      governance — from archival listening and urban sound, through platform urbanism, to civic AI.
    </p>
  </div>

  <div class="pub-canon">
    <a class="canon" href="https://scholar.google.com/citations?user=cnGxyWQAAAAJ&amp;hl=en" rel="noopener">
      Google Scholar<span class="canon-out" aria-hidden="true">&#8599;</span>
    </a>
    <a class="canon" href="https://orcid.org/0000-0002-0087-7166" rel="noopener">
      ORCID<span class="canon-id">0000-0002-0087-7166</span><span class="canon-out" aria-hidden="true">&#8599;</span>
    </a>
    <a class="canon" href="https://www.researchgate.net/profile/Sarah-Barns-4" rel="noopener">
      ResearchGate<span class="canon-out" aria-hidden="true">&#8599;</span>
    </a>
  </div>

  <WorkList items={items} />
</Base>

<style>
  .page-intro-lead {
    font-family: var(--display); font-weight: 400;
    font-size: clamp(1.15rem, 2.1vw, 1.4rem); line-height: 1.35;
    color: var(--text); letter-spacing: -0.005em; max-width: 34ch;
  }
  .page-intro-lead + .page-intro { margin-top: 0.7rem; }
  .pub-canon { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.8rem; }
  .canon {
    display: inline-flex; align-items: baseline; gap: 0.5rem;
    font-family: var(--heading); font-size: 0.78rem; color: var(--ember-ink);
    text-decoration: none; background: var(--ember-bg);
    border: 1px solid color-mix(in srgb, var(--ember-ink) 22%, transparent);
    border-radius: 3px; padding: 0.42rem 0.7rem;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }
  .canon:hover { color: var(--text); border-color: color-mix(in srgb, var(--ember-ink) 55%, transparent); }
  .canon-id { font-size: 0.68rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }
  .canon-out { font-size: 0.72rem; opacity: 0.6; }
  @media (max-width: 480px) { .canon-id { display: none; } }
</style>
