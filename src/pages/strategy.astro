---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Industry-facing outputs from the publications collection — reports, working
// papers and white papers belong with the advisory work, not the scholarly record.
const STRATEGY_TYPES = ['Commissioned Research Contracts', 'Commissioned Strategy & Advisory'];
const all = (await getCollection('publications'))
  .filter(p => !p.data.draft && STRATEGY_TYPES.includes(p.data.type))
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));

// Research contracts and strategy work are kept apart — they are different kinds of
// engagement and were reported differently.
const GROUPS = [
  {
    id: 'strategy-advisory',
    title: 'Commissioned Strategy & Advisory',
    lede: 'A highly experienced strategic advisor for a range of public and private organisations, spanning technology, urban transformation, placemaking, heritage and the arts.',
    items: all.filter(p => p.data.type === 'Commissioned Strategy & Advisory'),
  },
  {
    id: 'research-projects',
    title: 'Research Projects',
    lede: 'An independent and trusted research partner for a range of industry and government agencies, focusing on building long-term public value frameworks for organisations and communities in transition.',
    items: all.filter(p => p.data.type === 'Commissioned Research Contracts'),
  },
].filter(g => g.items.length > 0);
---

<Base title="Strategy — Sarah Barns">
  <div class="page-header">
    <p class="page-kicker"><span class="ktick"></span><em>practice &amp; advisory</em></p>
    <h1>Strategy</h1>
    <p class="page-intro">Civic AI governance, participatory design, and place-based strategy work delivered through Studio ESEM — for cultural institutions, councils, and communities.</p>
  </div>


  <div class="cta">
    <p>Interested in working together? I take on a small number of strategy and advisory engagements each year.</p>
    <a href="mailto:sarah@studioesem.com">Get in touch</a>
  </div>

  {GROUPS.map(group => (
    <div class="publications" id={group.id}>
      <h2 class="strategy-h2">{group.title}</h2>
      <p class="strategy-lede">{group.lede}</p>
      {group.items.map(r => (
        <div class="pub-item">
          <div class="pub-title">
            {r.data.href ? <a href={r.data.href} rel="noopener">{r.data.title}</a> : r.data.title}
          </div>
          <div class="pub-details">
            {r.data.authors && <span>{r.data.authors} &middot; </span>}
            {r.data.venue}, {r.data.yearLabel ?? r.data.year}
          </div>
          {r.data.note && <p class="strategy-description">{r.data.note}</p>}
          <div class="report-foot">
            <span class="pub-tag">{r.data.type}</span>
            {r.data.openAccess && (
              <a class="pub-oa" href={r.data.openAccess} rel="noopener">
                <span class="pub-oa-dot" aria-hidden="true"></span>Free to read
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  ))}

          </div>
        </div>
      ))}
    </div>
  )}
</Base>

<script>
  // Scroll-driven node highlight — same mechanism as the writing list & manifesto thread
  const items = document.querySelectorAll('.strategy-item');
  if (items.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-active', e.isIntersecting)),
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    items.forEach((el) => obs.observe(el));
  }
</script>
