---
import Base from '../layouts/Base.astro';
import WorkList from '../components/WorkList.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('work');
const items = all
  .filter(p => !p.data.draft && p.data.domain === 'Voices')
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));

// The programme that made the archive public, linked as its origin.
const pastForward = all.find(p => p.id.includes('past-forward'));
---

<Base title="Voices — Sarah Barns">
  <div class="page-header">
    <p class="page-kicker"><span class="ktick"></span><em>the open archive</em></p>
    <h1>Voices</h1>
    <p class="page-intro">
      Archival recordings carried out of closed collections and into public circulation. These are
      not my compositions. They are other people's voices, surfaced so they can be listened to,
      reused and built on.
    </p>
  </div>

  {pastForward && (
    <div class="voices-origin">
      <p>
        Most of these recordings are public because of
        <a href="/research?type=Creative+Research">Past Forward</a>, a partnership with ABC Pool
        negotiated in 2012 that released ABC television and radio archive material under
        <strong>CC BY 2.0</strong>.
      </p>
    </div>
  )}

  <WorkList items={items} />
</Base>

<style>
  .voices-origin {
    margin-top: 1.8rem; padding: 1.1rem 1.2rem;
    background: var(--ember-bg); border: 1px solid var(--border);
    border-left: 3px solid var(--oa-ink); border-radius: 3px;
  }
  .voices-origin p { margin: 0; font-size: 0.98rem; line-height: 1.6; color: var(--text-dim); max-width: 62ch; }
</style>
