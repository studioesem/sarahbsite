---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.sortYear - a.data.sortYear);

const strands = ['Strategy', 'Creative', 'Research'];
---

<Base
  title="Projects — Sarah Barns"
  description="Two decades of strategy, creative and research work — an archive of projects across public history, placemaking, platforms and civic AI."
>
  <div class="page-header proj-header">
    <p class="page-kicker"><span class="ktick"></span><em>an archive of practice</em></p>
    <h1>Projects</h1>
    <p class="page-intro">
      Cultivating and creating public histories and strategies for digital urbanism.
    </p>
  </div>

  <!-- Full-bleed portfolio band -->
  <section class="proj-bleed">
    <div class="proj-filters" role="group" aria-label="Filter projects by strand">
      <button class="proj-filter is-on" data-strand="all" aria-pressed="true">All</button>
      {strands.map((s) => (
        <button class="proj-filter" data-strand={s} aria-pressed="false">{s}</button>
      ))}
    </div>

    <ul class="proj-grid">
      {projects.map((p) => (
        <li class:list={['proj-cell', { 'is-featured': p.data.featured }]} data-strand={p.data.strand}>
          <div class="proj-card">
            <div class="proj-inner">
              <div class="proj-face proj-front">
                {p.data.image ? (
                  <img src={p.data.image} alt={p.data.imageAlt ?? p.data.title} loading="lazy" />
                ) : (
                  <div class="proj-front-blank" aria-hidden="true">
                    <span class="proj-big-year">{p.data.sortYear}</span>
                    <span class="proj-node"></span>
                  </div>
                )}
                <div class="proj-front-scrim">
                  <span class="proj-years">{p.data.years} · {p.data.strand}</span>
                  <span class="proj-title">{p.data.title}</span>
                </div>
                <button class="proj-flip" aria-expanded="false">
                  <span class="sr-only">More about {p.data.title}</span>
                  <span class="proj-flip-glyph" aria-hidden="true">&#8634;</span>
                </button>
              </div>
              <div class="proj-face proj-back">
                <span class="proj-strand">{p.data.strand} · {p.data.years}</span>
                <p class="proj-back-title">{p.data.title}</p>
                <p class="proj-summary">{p.data.summary}</p>
                {p.data.links && (
                  <div class="proj-links">
                    {p.data.links.map((l) => (
                      <a href={l.href}>{l.label}</a>
                    ))}
                  </div>
                )}
                {p.data.partner && <p class="proj-partner">{p.data.partner}</p>}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  /* Display type: Young Serif for the page and card titles, mono for meta. */
  .proj-header :global(h1) {
    font-family: var(--serif); font-weight: 400; letter-spacing: 0;
    font-size: clamp(2.4rem, 5vw, 3.4rem);
  }

  /* ===== Full-bleed band — breaks out of the 800px column ===== */
  .proj-bleed {
    width: 100vw; margin-left: calc(50% - 50vw);
    padding: 0 clamp(1.25rem, 4vw, 3rem) 3.5rem;
  }

  .proj-filters { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.6rem; }
  .proj-filter {
    font-family: var(--heading); font-size: 0.78rem; font-weight: 500;
    letter-spacing: 0.04em; color: var(--text-dim);
    background: none; border: 1px solid var(--border-hover); border-radius: 100px;
    padding: 0.32rem 0.85rem; cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .proj-filter:hover { border-color: var(--text); color: var(--text); }
  .proj-filter.is-on { background: var(--text); border-color: var(--text); color: var(--bg); }

  /* ===== Mosaic grid: uniform tiles + 2×2 featured tiles, dense-packed ===== */
  .proj-grid {
    list-style: none; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    grid-auto-rows: 250px; grid-auto-flow: dense;
    gap: clamp(0.8rem, 1.4vw, 1.25rem);
  }
  .proj-cell.is-featured { grid-column: span 2; grid-row: span 2; }
  .proj-cell[hidden] { display: none; }

  /* ===== Flip card ===== */
  .proj-card { perspective: 1400px; height: 100%; }
  .proj-inner {
    position: relative; width: 100%; height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(0.4, 0.1, 0.2, 1);
  }
  .proj-card.is-flipped .proj-inner { transform: rotateY(180deg); }
  @media (hover: hover) {
    .proj-card:hover .proj-inner,
    .proj-card:focus-within .proj-inner { transform: rotateY(180deg); }
  }

  .proj-face {
    position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
    border-radius: 3px; overflow: hidden;
  }

  /* Front */
  .proj-front { background: var(--hover-bg); }
  .proj-front img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    filter: grayscale(0.55) sepia(0.08);        /* same treatment as the avatar */
    transition: transform 0.6s ease, filter 0.4s ease;
  }
  .proj-card:hover .proj-front img { transform: scale(1.03); filter: grayscale(0.2) sepia(0.04); }

  /* Imageless front: strand-tinted typographic tile with a large ghost year */
  .proj-front-blank { position: absolute; inset: 0; }
  .proj-cell[data-strand='Strategy'] .proj-front { background: var(--accent-bg); }
  .proj-cell[data-strand='Creative'] .proj-front { background: rgba(214, 31, 58, 0.06); }
  .proj-cell[data-strand='Research'] .proj-front { background: rgba(0, 0, 0, 0.045); }
  .proj-big-year {
    position: absolute; top: -0.18em; right: 0.05em;
    font-family: var(--serif); font-size: clamp(4.5rem, 9vw, 7rem); line-height: 1;
    color: var(--text); opacity: 0.07; user-select: none;
  }
  .proj-front-blank::before {
    /* thread motif — faint vertical line echoing the post-list spine */
    content: ''; position: absolute; left: 1.4rem; top: 1.2rem; bottom: 4.5rem;
    width: 1px; background: color-mix(in srgb, var(--text) 22%, transparent);
  }
  .proj-node {
    position: absolute; left: 1.4rem; top: 1.2rem; transform: translateX(-50%);
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--bg); border: 1px solid var(--text-dim);
  }

  .proj-front-scrim {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column; gap: 0.3rem;
    padding: 2.4rem 1.2rem 1.1rem;
  }
  .proj-front:has(img) .proj-front-scrim {
    background: linear-gradient(to top, rgba(17,17,17,0.85) 40%, transparent);
  }
  .proj-years {
    font-family: var(--heading); font-size: 0.68rem; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.09em; color: var(--text-faint);
  }
  .proj-title {
    font-family: var(--serif); font-weight: 400; font-size: 1.35rem;
    line-height: 1.15; color: var(--text); max-width: 24ch;
  }
  .proj-cell.is-featured .proj-title { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .proj-front:has(img) .proj-years { color: rgba(255,255,255,0.72); }
  .proj-front:has(img) .proj-title { color: #fff; }

  .proj-flip {
    position: absolute; inset: 0; width: 100%; height: 100%;
    background: none; border: none; cursor: pointer;
    display: flex; align-items: flex-start; justify-content: flex-end; padding: 0.7rem;
  }
  .proj-flip:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 3px; }
  .proj-flip-glyph {
    font-size: 0.85rem; line-height: 1; color: var(--text-dim);
    border: 1px solid var(--border-hover); border-radius: 50%;
    width: 1.6rem; height: 1.6rem; display: inline-flex; align-items: center; justify-content: center;
    background: rgba(255,255,255,0.8);
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* Back */
  .proj-back {
    transform: rotateY(180deg);
    background: var(--text); color: #e7e5e4;      /* dark back — the card's "other side" */
    display: flex; flex-direction: column; gap: 0.55rem;
    padding: 1.2rem 1.3rem;
    visibility: hidden; transition: visibility 0s 0.28s;   /* keeps hidden links untabbable */
  }
  .proj-card.is-flipped .proj-back { visibility: visible; transition-delay: 0s; }
  @media (hover: hover) {
    .proj-card:hover .proj-back,
    .proj-card:focus-within .proj-back { visibility: visible; transition-delay: 0s; }
  }
  .proj-strand {
    font-family: var(--heading); font-size: 0.64rem; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.55);
  }
  .proj-back-title {
    font-family: var(--serif); font-weight: 400; font-size: 1.15rem; line-height: 1.2;
    color: #fff;
  }
  .proj-cell.is-featured .proj-back-title { font-size: 1.5rem; }
  .proj-summary {
    font-size: 0.86rem; line-height: 1.55; color: rgba(255,255,255,0.78);
    overflow-y: auto; padding-right: 0.5rem;
    scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.28) transparent;
  }
  .proj-summary::-webkit-scrollbar { width: 4px; }
  .proj-summary::-webkit-scrollbar-track { background: transparent; }
  .proj-summary::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.25); border-radius: 4px;
  }
  .proj-summary::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.4); }
  .proj-cell.is-featured .proj-summary { font-size: 0.95rem; max-width: 52ch; }
  .proj-links { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: auto; }
  .proj-links a {
    font-family: var(--heading); font-size: 0.8rem; color: #fff;
    text-decoration-color: var(--accent-light);
  }
  .proj-links a:hover { color: var(--accent-light); }
  .proj-links a::after { content: ' \2192'; }
  .proj-partner {
    font-family: var(--heading); font-size: 0.66rem; font-weight: 300;
    text-transform: uppercase; letter-spacing: 0.07em; color: rgba(255,255,255,0.45);
  }

  /* Reduced motion: crossfade instead of the 3D turn */
  @media (prefers-reduced-motion: reduce) {
    .proj-inner { transition: none; transform: none !important; }
    .proj-face { transition: opacity 0.25s ease; }
    .proj-back { transform: none; opacity: 0; }
    .proj-front { opacity: 1; }
    .proj-card.is-flipped .proj-back { opacity: 1; }
    .proj-card.is-flipped .proj-front { opacity: 0; }
    .proj-card:hover .proj-front img { transform: none; }
    @media (hover: hover) {
      .proj-card:hover .proj-back, .proj-card:focus-within .proj-back { opacity: 1; }
      .proj-card:hover .proj-front, .proj-card:focus-within .proj-front { opacity: 0; }
    }
  }

  @media (max-width: 640px) {
    .proj-grid { grid-template-columns: 1fr; grid-auto-rows: 230px; }
    .proj-cell.is-featured { grid-column: auto; grid-row: span 2; }
  }
</style>

<script>
  // Tap / click / keyboard flip. Hover flip is pure CSS on hover-capable devices;
  // the button makes the flip reachable on touch and by keyboard, and lets a
  // hover-flip be "pinned" open with a click.
  document.querySelectorAll<HTMLButtonElement>('.proj-flip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.proj-card');
      if (!card) return;
      const flipped = card.classList.toggle('is-flipped');
      btn.setAttribute('aria-expanded', String(flipped));
    });
  });

  // Strand filter
  const filters = document.querySelectorAll<HTMLButtonElement>('.proj-filter');
  const cells = document.querySelectorAll<HTMLLIElement>('.proj-cell');
  filters.forEach((f) => {
    f.addEventListener('click', () => {
      filters.forEach((o) => {
        o.classList.toggle('is-on', o === f);
        o.setAttribute('aria-pressed', String(o === f));
      });
      const strand = f.dataset.strand;
      cells.forEach((c) => {
        c.hidden = strand !== 'all' && c.dataset.strand !== strand;
      });
    });
  });
</script>
