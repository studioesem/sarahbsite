---
interface BannerSpec {
  src: string;
  captionTitle?: string;
  captionBody?: string;
}

interface Props {
  title?: string;
  description?: string;
  banner?: BannerSpec;
}

const NAV = [
  { href: '/highlights', label: 'Highlights' },
  { href: '/research', label: 'Research' },
  { href: '/creative', label: 'Creative' },
  { href: '/strategy', label: 'Strategy' },
  { href: '/writing', label: 'Interviews & Essays' },
  { href: '/listening', label: 'Listening' },
  { href: '/places-are-made-of-wax.html', label: 'Resonant Places' },
  { href: '/about', label: 'About' },
];

// Trailing slash stripped so /writing/ and /writing/a-post both mark Writing as current.
const here = Astro.url.pathname.replace(/\/+$/, '') || '/';

const DEFAULT_BANNER: BannerSpec = {
  src: 'https://pub-3c698ebb77b146ac884e0a95b8523934.r2.dev/digital-placemaking/girl-eating-a-sandwich-unguarded-moments-millers-point-sd.mp4',
  captionTitle: "'Girl Eating a Sandwich'",
  captionBody: "Featured for Unguarded Moments, Sarah's first public space archive project with Michael Killalea of Studio ESEM, 2011. The girl plays on a loop, looking back from the 1930s docks, wondering about the future world she finds herself in.",
};

const {
  title = 'Sarah Barns',
  description = 'Public historian and creative producer working with digital methods to enliven storied-connections between people, places, and habitats.',
  banner = DEFAULT_BANNER,
} = Astro.props;
const currentPath = Astro.url.pathname;
const hasCaption = Boolean(banner.captionTitle || banner.captionBody);

// Author identity graph. Identical block also lives on civicinterplay.io,
// storybox.co, studioesem.com. Same @id everywhere so crawlers fuse the
// four surfaces into one Person entity.
const identityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://civicinterplay.io/#sarahbarns',
      name: 'Sarah Barns',
      givenName: 'Sarah',
      familyName: 'Barns',
      url: 'https://sarahbarns.com/',
      jobTitle: "Vice Chancellor's Senior Research Fellow",
      affiliation: [
        {
          '@type': 'Organization',
          name: 'RMIT University',
          url: 'https://www.rmit.edu.au/',
        },
        { '@id': 'https://www.studioesem.com/#org' },
      ],
      identifier: {
        '@type': 'PropertyValue',
        propertyID: 'ORCID',
        value: '0000-0002-0087-7166',
      },
      sameAs: [
        'https://orcid.org/0000-0002-0087-7166',
        'https://scholar.google.com/citations?user=cnGxyWQAAAAJ',
        'https://www.rmit.edu.au/profiles/b/sarah-barns2',
        'https://www.linkedin.com/in/sarahbarns/',
        'https://civicinterplay.io/',
        'https://www.studioesem.com/',
        'https://storybox.co/',
        'https://sarahbarns.com/',
      ],
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.studioesem.com/#org',
      name: 'Studio ESEM',
      alternateName: 'Esem Projects',
      url: 'https://www.studioesem.com/',
      founder: [
        { '@id': 'https://civicinterplay.io/#sarahbarns' },
        { '@type': 'Person', name: 'Michael Killalea' },
      ],
    },
    {
      '@type': 'Organization',
      '@id': 'https://storybox.co/#org',
      name: 'STORYBOX',
      url: 'https://storybox.co/',
      parentOrganization: { '@id': 'https://www.studioesem.com/#org' },
      founder: { '@id': 'https://civicinterplay.io/#sarahbarns' },
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Sarah Barns" href="/rss.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(identityGraph)}></script>
</head>
<body>
  <div class="container">
    <nav>
      <a href="/" class="nav-name">Sarah Barns</a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="nav-links" aria-label="Menu">
        <span class="nav-bar"></span><span class="nav-bar"></span><span class="nav-bar"></span>
      </button>
      <ul class="nav-links" id="nav-links">
        {NAV.map(item => (
          <li>
            <a
              href={item.href}
              class={`nav-link${here === item.href || here.startsWith(item.href + '/') ? ' is-here' : ''}`}
              aria-current={here === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <script is:inline>
      (() => {
        const btn = document.querySelector('.nav-toggle');
        const list = document.getElementById('nav-links');
        if (!btn || !list) return;
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          list.classList.toggle('is-open', !open);
        });
      })();
    </script>

    <slot />

    <footer>
      <div class="footer-socials">
        <a href="https://civicinterplay.io" title="Civic Interplay"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></a>
        <a href="https://storybox.co" title="STORYBOX"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></a>
        <a href="https://scholar.google.com/citations?user=cnGxyWQAAAAJ&amp;hl=en" title="Google Scholar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg></a>
        <a href="https://www.linkedin.com/in/sarahbarns" title="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>
        <a href="mailto:sarah@studioesem.com" title="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></a>
      </div>
      <p class="footer-note">&copy; {new Date().getFullYear()} Sarah Barns </p>
    </footer>
  </div>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
